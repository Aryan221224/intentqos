#!/bin/sh /etc/rc.common
# procd service for IntentQoS: engine + independent watchdog + (optional) controller agent.
START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/python3
CONF=/var/etc/intentqos.toml

start_service() {
	config_load intentqos
	config_get_bool enabled engine enabled 1
	[ "$enabled" = 1 ] || return 0
	mkdir -p /var/etc /var/run/intentqos /tmp/intentqos /etc/intentqos
	/usr/sbin/intentqos-uci > "$CONF" || return 1

	procd_open_instance engine
	procd_set_param command $PROG -m intentqos.daemon --config "$CONF"
	procd_set_param env PYTHONPATH=/usr/lib/intentqos
	procd_set_param respawn 3600 2 0          # restart quickly; the watchdog covers the gap
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command $PROG -m intentqos.watchdog --config "$CONF"
	procd_set_param env PYTHONPATH=/usr/lib/intentqos
	procd_set_param respawn
	procd_close_instance

	config_get_bool agent agent enabled 0
	if [ "$agent" = 1 ]; then
		procd_open_instance agent
		procd_set_param command $PROG -m intentqos.agent --config "$CONF"
		procd_set_param env PYTHONPATH=/usr/lib/intentqos
		procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "intentqos"
}
