# /etc/config/intentqos -- IntentQoS adaptive QoS engine (edit with `uci` or LuCI)

config intentqos 'engine'
	option enabled '1'
	# download shaping happens on the LAN side
	option lan 'br-lan'
	# the WAN device (e.g. eth0, wan, pppoe-wan) for upload shaping
	option wan 'wan'
	list lan_subnet '192.168.1.0/24'
	# plan rates; the operator's controller overrides these from billing
	option down_mbit '100'
	option up_mbit '20'
	# ml | rules
	option classifier 'ml'
	option nat '1'
	option api_listen '192.168.1.1:8080'
	# console and API need the router key (cat /etc/intentqos/admin.key); '0' only on a lab bench
	option require_auth '1'
	# what the watchdog leaves behind: safe | passthrough
	option exit_state 'safe'
	list reflector '1.1.1.1'
	list reflector '8.8.8.8'
	list reflector '9.9.9.9'

config intentqos 'agent'
	# 1 = connect to the operator's controller
	option enabled '0'
	# e.g. https://qos.isp.example
	option controller_url ''
	# one-time enrolment code from the router label (factory provisioned)
	option claim_code ''
	option ca_file '/etc/intentqos/operator-ca.pem'
	# operator release key (Ed25519, hex) for signed configs and models
	option release_pubkey ''
	option telemetry_interval_s '15'
